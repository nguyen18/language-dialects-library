{
  "name": "which-dialect-tool",
  "version": "0.1.0",
  "description": "Find how words are said in different regions and dialects of a language (Spanish, Vietnamese, …), with Wiktionary data loaded on demand.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dictionary",
    "dialect",
    "regional",
    "translation",
    "language-learning",
    "wiktionary",
    "spanish",
    "vietnamese"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyen18/which-dialect-tool.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nguyen18/which-dialect-tool#readme"
}
